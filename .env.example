# Postgres. On Supabase (Project Settings > Database > Connect):
#   DATABASE_URL = "Transaction pooler" URL (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Session pooler" or direct URL (port 5432), used for migrations
# Locally: npx prisma dev --name humynex --detach, then use the URL it prints for both.
DATABASE_URL=
DIRECT_URL=

# Supabase Storage (Project Settings > API). The service role key is secret: server only, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

SEED_ADMIN_EMAIL="admin@humynex.com"
SEED_ADMIN_PASSWORD=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Authorised redirect URI: <your site>/api/auth/google/callback  (and http://localhost:3000/api/auth/google/callback for local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Extra admin emails, comma-separated (the two owner addresses are always admins).
ADMIN_EMAILS=
